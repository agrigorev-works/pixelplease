{
  "name": "pixelplease",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:og-image": "node scripts/check-og-image.mjs",
    "prepare:samples": "node scripts/prepare-samples.mjs",
    "clean": "rm -rf dist test-results test-artifacts",
    "test": "vitest run tests/*.test.ts",
    "test:smoke": "npm run build && npm run prepare:samples && playwright test",
    "test:launch": "npm run build && npm run prepare:samples && playwright test -c playwright.launch.config.ts",
    "verify": "npm run check:og-image && npm run test && npm run test:smoke"
  },
  "dependencies": {
    "opentype.js": "^1.3.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "@types/opentype.js": "^1.3.8",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  }
}
